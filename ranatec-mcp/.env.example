# ranatec-mcp configuration (all optional)
RANATEC_API_BASE=https://ranatec.com/agent/v1
PORT=3000
API_TIMEOUT_MS=10000
CACHE_TTL_MS=300000
RATE_LIMIT_PER_MIN=100
# Express "trust proxy" — keep "loopback" behind a local nginx; set the proxy IP/CIDR otherwise
TRUST_PROXY=loopback
# Optional shared key. When set here AND in WordPress (Tools → Ranatec Agent API → MCP server key),
# the plugin accepts leads only from this MCP server. Use a long random value (e.g. `openssl rand -hex 24`).
RANATEC_MCP_KEY=
